# ---------------------------------------------------
# 1. Gemini API 키
# 발급 방법: https://aistudio.google.com 접속 → 구글 계정 로그인
#           → 좌측 메뉴 'Get API key' → 'Create API key' 클릭
#           → 카드 등록 없이 무료로 즉시 발급 가능
# ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------
# 2. Kakao Local API 키 (REST API 키)
# 발급 방법: https://developers.kakao.com 접속 → 카카오 계정 로그인
#           → '내 애플리케이션' → '애플리케이션 추가'로 앱 생성
#           → 생성된 앱 클릭 → 'REST API 키' 값 복사
#           (JavaScript 키, Admin 키와 혼동하지 않도록 주의)
# ---------------------------------------------------
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here